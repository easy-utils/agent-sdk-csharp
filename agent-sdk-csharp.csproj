<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Agentsdk</RootNamespace>
    <PackageId>AgentSdkCsharp</PackageId>
    <Version>0.15.0</Version>
    <Authors>EasyLab</Authors>
    <Description>Typed .NET client for the agent.v1 backend over easy-rpc.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EasyRpc" Version="0.4.1" />
  </ItemGroup>
</Project>
